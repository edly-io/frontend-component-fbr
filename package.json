{
  "name": "@edly-io/frontend-component-fbr",
  "version": "1.0.0",
  "description": "Shared React component library for Open edX authoring/FBR frontends",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edly-io/frontend-component-fbr.git"
  },
  "author": "Arbisoft",
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && fedx-scripts babel src --out-dir dist --extensions \".ts,.tsx\" --source-maps --ignore \"src/**/*.test.ts\",\"src/**/*.test.tsx\",\"**/__mocks__\",\"**/__snapshots__\" --copy-files --no-copy-ignored && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --project tsconfig.build.json",
    "lint": "fedx-scripts eslint --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "lint:fix": "fedx-scripts eslint --fix --ext .js --ext .jsx --ext .ts --ext .tsx .",
    "test": "TZ=UTC fedx-scripts jest --coverage --passWithNoTests",
    "test:ci": "TZ=UTC fedx-scripts jest --silent --coverage --passWithNoTests",
    "types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openedx/paragon": "^23.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.18.6",
    "@edx/typescript-config": "^1.0.1",
    "@openedx/frontend-build": "^14.6.2",
    "@openedx/paragon": "^23.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "jest-expect-message": "^1.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.1.4",
    "typescript": "^4.9.4"
  }
}
